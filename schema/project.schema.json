{
  "$id": "director3d.project.schema.json",
  "title": "3D 導演台 project",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "format": {
      "default": "director3d.project",
      "type": "string",
      "const": "director3d.project"
    },
    "version": {
      "default": 1,
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "name": {
      "default": "未命名專案",
      "type": "string",
      "maxLength": 200
    },
    "revision": {
      "default": 0,
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "createdAt": {
      "type": "string"
    },
    "updatedAt": {
      "type": "string"
    },
    "settings": {
      "default": {},
      "type": "object",
      "properties": {
        "duration": {
          "default": 10,
          "type": "number",
          "minimum": 1,
          "maximum": 30
        },
        "fps": {
          "default": 24,
          "anyOf": [
            {
              "type": "number",
              "const": 24
            },
            {
              "type": "number",
              "const": 25
            },
            {
              "type": "number",
              "const": 30
            },
            {
              "type": "number",
              "const": 50
            },
            {
              "type": "number",
              "const": 60
            }
          ]
        },
        "aspect": {
          "default": "16:9",
          "type": "string"
        },
        "resolution": {
          "default": [
            1920,
            1080
          ],
          "type": "array",
          "items": [
            {
              "type": "integer",
              "minimum": 16,
              "maximum": 8192
            },
            {
              "type": "integer",
              "minimum": 16,
              "maximum": 8192
            }
          ],
          "additionalItems": false,
          "minItems": 2,
          "maxItems": 2
        },
        "environment": {
          "default": {},
          "type": "object",
          "properties": {
            "preset": {
              "default": "day",
              "type": "string",
              "enum": [
                "day",
                "golden",
                "dusk",
                "night",
                "overcast",
                "studio"
              ]
            },
            "skyColor": {
              "default": null,
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "sunAzimuth": {
              "default": 135,
              "type": "number",
              "minimum": -360,
              "maximum": 360
            },
            "sunElevation": {
              "default": 50,
              "type": "number",
              "minimum": -10,
              "maximum": 90
            },
            "fog": {
              "default": true,
              "type": "boolean"
            },
            "fogDensity": {
              "default": 0.2,
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "shadows": {
              "default": false,
              "type": "boolean"
            }
          }
        }
      }
    },
    "objects": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
          },
          "type": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "default": "",
            "type": "string",
            "maxLength": 120
          },
          "color": {
            "default": "#9aa4b2",
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "position": {
            "default": [
              0,
              0,
              0
            ],
            "type": "array",
            "items": [
              {
                "type": "number"
              },
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "additionalItems": false,
            "minItems": 3,
            "maxItems": 3
          },
          "rotation": {
            "default": [
              0,
              0,
              0
            ],
            "type": "array",
            "items": [
              {
                "type": "number"
              },
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "additionalItems": false,
            "minItems": 3,
            "maxItems": 3
          },
          "scale": {
            "default": [
              1,
              1,
              1
            ],
            "type": "array",
            "items": [
              {
                "type": "number"
              },
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "additionalItems": false,
            "minItems": 3,
            "maxItems": 3
          },
          "visible": {
            "default": true,
            "type": "boolean"
          },
          "locked": {
            "default": false,
            "type": "boolean"
          },
          "params": {
            "default": {},
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "camera": {
            "type": "object",
            "properties": {
              "rig": {
                "default": "tripod",
                "type": "string",
                "enum": [
                  "tripod",
                  "handheld",
                  "dolly",
                  "crane",
                  "drone"
                ]
              },
              "lens": {
                "default": "standard",
                "type": "string",
                "enum": [
                  "standard",
                  "fisheye",
                  "panorama"
                ]
              },
              "focalLength": {
                "default": 35,
                "type": "number",
                "minimum": 2,
                "maximum": 1200
              },
              "sensor": {
                "default": "super35",
                "type": "string",
                "enum": [
                  "fullFrame",
                  "super35",
                  "apsc",
                  "mft",
                  "oneInch",
                  "phone"
                ]
              },
              "fisheye": {
                "default": {},
                "type": "object",
                "properties": {
                  "fov": {
                    "default": 180,
                    "type": "number",
                    "minimum": 60,
                    "maximum": 360
                  },
                  "mapping": {
                    "default": "equidistant",
                    "type": "string",
                    "enum": [
                      "equidistant",
                      "equisolid",
                      "stereographic",
                      "orthographic"
                    ]
                  },
                  "circular": {
                    "default": false,
                    "type": "boolean"
                  }
                }
              },
              "lookAt": {
                "default": null,
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "target": {
                        "default": null,
                        "anyOf": [
                          {
                            "type": "string",
                            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "point": {
                        "default": null,
                        "anyOf": [
                          {
                            "type": "array",
                            "items": [
                              {
                                "type": "number"
                              },
                              {
                                "type": "number"
                              },
                              {
                                "type": "number"
                              }
                            ],
                            "additionalItems": false,
                            "minItems": 3,
                            "maxItems": 3
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "aim": {
                        "default": "auto",
                        "type": "string",
                        "enum": [
                          "auto",
                          "head",
                          "chest",
                          "center",
                          "feet"
                        ]
                      },
                      "offset": {
                        "default": [
                          0,
                          0,
                          0
                        ],
                        "type": "array",
                        "items": [
                          {
                            "type": "number"
                          },
                          {
                            "type": "number"
                          },
                          {
                            "type": "number"
                          }
                        ],
                        "additionalItems": false,
                        "minItems": 3,
                        "maxItems": 3
                      }
                    }
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "follow": {
                "default": null,
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "target": {
                        "type": "string",
                        "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
                      },
                      "offset": {
                        "default": [
                          0,
                          2,
                          5
                        ],
                        "type": "array",
                        "items": [
                          {
                            "type": "number"
                          },
                          {
                            "type": "number"
                          },
                          {
                            "type": "number"
                          }
                        ],
                        "additionalItems": false,
                        "minItems": 3,
                        "maxItems": 3
                      },
                      "space": {
                        "default": "world",
                        "type": "string",
                        "enum": [
                          "world",
                          "local"
                        ]
                      },
                      "lag": {
                        "default": 0,
                        "type": "number",
                        "minimum": 0,
                        "maximum": 5
                      }
                    },
                    "required": [
                      "target"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "shake": {
                "default": {},
                "type": "object",
                "properties": {
                  "preset": {
                    "default": "none",
                    "type": "string",
                    "enum": [
                      "none",
                      "handheld",
                      "walk",
                      "drone",
                      "vehicle",
                      "earthquake"
                    ]
                  },
                  "amount": {
                    "default": 0.5,
                    "type": "number",
                    "minimum": 0,
                    "maximum": 2
                  },
                  "seed": {
                    "default": 1,
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1000000
                  }
                }
              }
            }
          },
          "tracks": {
            "default": {},
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "keys": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "t": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 30
                      },
                      "v": {},
                      "ease": {
                        "type": "string",
                        "enum": [
                          "linear",
                          "in",
                          "out",
                          "inOut",
                          "hold"
                        ]
                      }
                    },
                    "required": [
                      "t",
                      "v"
                    ]
                  }
                },
                "path": {
                  "type": "string",
                  "enum": [
                    "linear",
                    "smooth"
                  ]
                }
              },
              "required": [
                "keys"
              ]
            }
          },
          "note": {
            "type": "string",
            "maxLength": 2000
          }
        },
        "required": [
          "id",
          "type"
        ]
      }
    },
    "cuts": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "t": {
            "type": "number",
            "minimum": 0,
            "maximum": 30
          },
          "camera": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
          }
        },
        "required": [
          "t",
          "camera"
        ]
      }
    },
    "markers": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "t": {
            "type": "number",
            "minimum": 0,
            "maximum": 30
          },
          "label": {
            "type": "string",
            "maxLength": 200
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          }
        },
        "required": [
          "t",
          "label"
        ]
      }
    },
    "notes": {
      "type": "string",
      "maxLength": 20000
    }
  },
  "required": [
    "id"
  ]
}