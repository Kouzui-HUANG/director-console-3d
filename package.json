{
  "name": "director-console-3d",
  "private": true,
  "version": "0.1.0",
  "description": "3D 導演台：低多邊形預視、多機位剪輯、MP4 輸出，人類與 AI Agent（MCP）都能操作",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node server/index.ts --dev",
    "start": "npm run build && node server/index.ts",
    "serve": "node server/index.ts",
    "build": "vite build",
    "dev:vite": "vite",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "schema": "node scripts/gen-schema.ts",
    "mcp": "node server/mcp.ts",
    "mac-app": "bash scripts/make-mac-app.sh"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "immer": "^11.2.9",
    "mediabunny": "^1.65.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "ws": "^8.18.3",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.187.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
